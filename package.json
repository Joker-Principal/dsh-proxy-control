{
  "name": "dsh-proxy-control",
  "version": "0.7.8",
  "description": "在运行中控制 DeepSeek Harness 的出站代理：设置界面（内置/系统/手动三选一）+ 系统代理探测 + 连通性自测 + 如实状态上报，改动无需重启",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joker-Principal/dsh-proxy-control.git"
  },
  "homepage": "https://github.com/Joker-Principal/dsh-proxy-control#readme",
  "bugs": {
    "url": "https://github.com/Joker-Principal/dsh-proxy-control/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/proxy.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proxy",
    "http-proxy"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
